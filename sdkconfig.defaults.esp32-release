# ESP System Settings
#
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_MINIMAL_SHARED_STACK_SIZE=8192
